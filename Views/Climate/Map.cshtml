@model ClimatePageViewModel
@{
    ViewData["Title"] = "Weather Map";
    var latStr = Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var lonStr = Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<div class="mb-4"><div class="eyebrow">GEOGRAPHIC VIEW</div><h1 class="page-title">Weather Map</h1><p class="muted">Explore the selected monitoring location and its coordinates.</p></div>
@if (!string.IsNullOrEmpty(Model.Error)) {
  <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
    <span>⚠️</span><div>@Model.Error</div>
  </div>
}
<div class="row g-3">
 <div class="col-lg-8"><div class="content-card p-2"><div id="weatherMap"></div></div></div>
 <div class="col-lg-4"><div class="content-card h-100"><span class="tag">SELECTED LOCATION</span><h4 class="mt-3">@Model.Location</h4><p class="muted">Latitude: @Model.Latitude.ToString("0.0000")<br>Longitude: @Model.Longitude.ToString("0.0000")</p>
 @if (Model.Weather?.Current != null) {
   <div class="map-temp">@Model.Weather.Current.Temperature.ToString("0.0")°C</div>
   <p>@Model.WeatherDescription</p>
   <hr>
   <div class="d-flex justify-content-between"><span>Humidity</span><strong>@Model.Weather.Current.Humidity.ToString("0")%</strong></div>
   <div class="d-flex justify-content-between mt-2"><span>Wind</span><strong>@Model.Weather.Current.WindSpeed.ToString("0.0") km/h</strong></div>
   <div class="d-flex justify-content-between mt-2"><span>Rainfall</span><strong>@Model.Weather.Current.Precipitation.ToString("0.0") mm</strong></div>
 } else {
   <div class="alert alert-light border mt-3 small text-muted">Live weather metrics unavailable for these coordinates.</div>
 }
 <a class="btn btn-green w-100 mt-4" asp-action="Dashboard" asp-route-latitude="@latStr" asp-route-longitude="@lonStr" asp-route-location="@Model.Location">Open dashboard</a></div></div>
</div>
@section Scripts {
<script>
const lat = @latStr;
const lon = @lonStr;
const map = L.map('weatherMap').setView([lat, lon], 10);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors'
}).addTo(map);
L.marker([lat, lon]).addTo(map).bindPopup('<b>@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(Model.Location))</b><br>Monitoring location').openPopup();
L.circle([lat, lon], {
    radius: 1800,
    color: '#23845b',
    fillOpacity: .12
}).addTo(map);
</script>
}
