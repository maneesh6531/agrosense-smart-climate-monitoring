@model ClimatePageViewModel
@{ ViewData["Title"] = "Weather Map"; }
<div class="mb-4"><div class="eyebrow">GEOGRAPHIC VIEW</div><h1 class="page-title">Weather Map</h1><p class="muted">Explore the selected monitoring location and its coordinates.</p></div>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-warning">@Model.Error</div> }
<div class="row g-3">
 <div class="col-lg-8"><div class="content-card p-2"><div id="weatherMap"></div></div></div>
 <div class="col-lg-4"><div class="content-card h-100"><span class="tag">SELECTED LOCATION</span><h4 class="mt-3">@Model.Location</h4><p class="muted">Latitude: @Model.Latitude.ToString("0.0000")<br>Longitude: @Model.Longitude.ToString("0.0000")</p>
 @if (Model.Weather.Current != null) { <div class="map-temp">@Model.Weather.Current.Temperature.ToString("0.0")°C</div><p>@Model.WeatherDescription</p><hr><div class="d-flex justify-content-between"><span>Humidity</span><strong>@Model.Weather.Current.Humidity%</strong></div><div class="d-flex justify-content-between mt-2"><span>Wind</span><strong>@Model.Weather.Current.WindSpeed km/h</strong></div><div class="d-flex justify-content-between mt-2"><span>Rainfall</span><strong>@Model.Weather.Current.Precipitation mm</strong></div> }
 <a class="btn btn-green w-100 mt-4" asp-action="Dashboard" asp-route-latitude="@Model.Latitude" asp-route-longitude="@Model.Longitude" asp-route-location="@Model.Location">Open dashboard</a></div></div>
</div>
@section Scripts {
<script>
const map=L.map('weatherMap').setView([@Model.Latitude,@Model.Longitude],10);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
L.marker([@Model.Latitude,@Model.Longitude]).addTo(map).bindPopup('<b>@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(Model.Location))</b><br>Monitoring location').openPopup();
L.circle([@Model.Latitude,@Model.Longitude],{radius:1800,color:'#23845b',fillOpacity:.12}).addTo(map);
</script>
}
