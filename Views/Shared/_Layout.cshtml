<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroClimate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="appSidebar">
        <a class="brand" asp-controller="Climate" asp-action="Dashboard">
            <span class="brand-mark">🌱</span>
            <span><strong>AgroClimate</strong><small>SMART AGRICULTURE</small></span>
        </a>
        <div class="sidebar-label">WORKSPACE</div>
        <nav class="side-nav">
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Climate" asp-action="Dashboard"><span class="side-icon">▦</span> Dashboard</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Map" ? "active" : "")" asp-controller="Climate" asp-action="Map"><span class="side-icon">⌖</span> Weather Map</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "active" : "")" asp-controller="Climate" asp-action="Analytics"><span class="side-icon">▥</span> Analytics</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Forecast" ? "active" : "")" asp-controller="Climate" asp-action="Forecast"><span class="side-icon">☼</span> Forecast</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Recommendations" ? "active" : "")" asp-controller="Climate" asp-action="Recommendations"><span class="side-icon">✧</span> Recommendations</a>
        </nav>
        <div class="sidebar-bottom">
            <div class="status-card"><span class="status-dot"></span><div><strong>Weather API</strong><small>Connected via Open-Meteo</small></div></div>
            <div class="sidebar-foot">Climate Monitoring System<br>Version 1.0</div>
        </div>
    </aside>

    <div class="main-shell">
        <header class="topbar">
            <button class="mobile-menu" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')">☰</button>
            <div class="topbar-context"><span class="topbar-kicker">AGRICULTURE INTELLIGENCE</span><strong>Climate Monitoring Platform</strong></div>
            <div class="topbar-right"><span class="topbar-live"><i></i> Live data</span><span class="user-avatar">AC</span></div>
        </header>
        <main class="page-content">
            @RenderBody()
        </main>
        <footer class="footer">© @DateTime.Now.Year AgroClimate · Weather data powered by Open-Meteo</footer>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
